{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "files": {
    "includes": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.css",
      "**/*.json",
      "!**/.next",
      "!**/node_modules",
      "!**/coverage",
      "!**/test-results",
      "!**/playwright-report"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100
  },
  "css": {
    "parser": { "tailwindDirectives": true }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "a11y": { "recommended": true },
      "suspicious": { "recommended": true },
      "style": { "noDescendingSpecificity": "off" }
    }
  },
  "assist": {
    "actions": { "source": { "organizeImports": "on" } }
  }
}
